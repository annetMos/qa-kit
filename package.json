{
  "name": "qa-kit",
  "version": "0.1.0",
  "description": "Модульный каркас автотестов на Playwright + TypeScript для фичевых проверок API + UI, понятный новичкам",
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e",
    "api-testing",
    "qa",
    "page-object",
    "framework"
  ],
  "author": "Anna Moskaleva",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "demo": "node demo-app/server.mjs",
    "typecheck": "tsc --noEmit",
    "features": "tsx scripts/features.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
