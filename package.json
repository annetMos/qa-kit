{
  "name": "qa-kit-example",
  "version": "0.4.0",
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e",
    "api-testing",
    "qa",
    "page-object",
    "framework"
  ],
  "author": "Anna Moskaleva",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @qa-kit/core",
    "pretest": "npm run build",
    "test": "playwright test",
    "test:ui": "npm run build && playwright test --ui",
    "report": "playwright show-report",
    "demo": "node demo-app/server.mjs",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit",
    "prefeatures": "npm run build",
    "features": "node packages/core/dist/cli.js features",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2",
    "@qa-kit/core": "*"
  },
  "description": "Example project and development workspace for @qa-kit/core",
  "workspaces": [
    "packages/*"
  ]
}
